# Build-time variables for the React client.
#
# Vite loads .env in every mode, then .env.<mode> on top of it for the mode it
# runs in; staging and production match the Wrangler environments in
# wrangler.json. Copy this file for each one you use:
#   cp .env.example .env              # npm run dev
#   cp .env.example .env.staging      # npm run deploy:staging
#   cp .env.example .env.production   # npm run deploy:production
#
# Git ignores all three, so every machine, and CI, makes its own. Set
# VITE_API_BASE_URL in .env.staging and .env.production too: a mode file that
# leaves it out falls back to the local .env value. Machine-specific overrides
# can also go in .env.<mode>.local, which git ignores.
#
# Only VITE_-prefixed keys reach the app, and they are inlined into the public
# bundle at build time. Never put a secret in these files.
#
# Cloudflare credentials do not belong here: run `npx wrangler login` locally,
# and set CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in CI.

# Base URL of pokerland-api, no trailing slash.
#   development: http://localhost:8000
#   staging:     the API's dev stage, https://[api-id].execute-api.ap-northeast-2.amazonaws.com/dev
#   production:  https://[api-domain-prod]
# The API must list this app's origin in its CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=http://localhost:8000
