# Build-time variables for the React client.
#
# Vite loads .env.<mode> for the mode it runs in, and each mode matches a
# Wrangler environment in wrangler.json. Copy this file once per mode:
#   cp .env.example .env.development   # npm run dev
#   cp .env.example .env.staging       # npm run deploy:staging
#   cp .env.example .env.production    # npm run deploy:production
#
# Only VITE_-prefixed keys reach the app, and they are inlined into the public
# bundle at build time. Never put a secret in these files. Because the values
# are public, commit .env.staging and .env.production so every machine and CI
# builds the same thing. Machine-specific overrides go in .env.<mode>.local,
# which git ignores.
#
# Cloudflare credentials do not belong here: run `npx wrangler login` locally,
# and set CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in CI.

# Base URL of pokerland-api, no trailing slash.
#   development: http://localhost:8000
#   staging:     the API's dev stage, https://[api-id].execute-api.ap-northeast-2.amazonaws.com/dev
#   production:  https://[api-domain-prod]
# The API must list this app's origin in its CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=http://localhost:8000
