{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokerland",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": true
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "[PRODUCTION_DOMAIN]",
          "custom_domain": true
        }
      ]
    }
  }
}
